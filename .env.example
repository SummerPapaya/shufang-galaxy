# 公共「宇宙回声」存储（Vercel KV / Upstash Redis）
# 在 Vercel 项目里接入 KV 后会自动注入；本地可用 `vercel env pull`。
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 或直接使用 Upstash：
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 可选：限制 CORS（逗号分隔）。留空则允许 *（适合同域部署）
# ECHOES_CORS_ORIGIN=https://shufang-galaxy.summercommences.com

# 可选：前端指向独立 API（GitHub Pages 前端 + Vercel API 时使用）
# VITE_ECHOES_API=https://your-app.vercel.app/api/echoes
